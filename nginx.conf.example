# Configuration Nginx pour le portfolio
# À placer dans /etc/nginx/sites-available/anass-erekysy.dev
# Puis créer un lien symbolique : sudo ln -s /etc/nginx/sites-available/anass-erekysy.dev /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name anass-erekysy.dev www.anass-erekysy.dev;
    
    # Redirection HTTP vers HTTPS (décommenter après configuration SSL)
    # return 301 https://$server_name$request_uri;
    
    root /var/www/html;
    index index.html;
    
    # Logs
    access_log /var/log/nginx/anass-erekysy.access.log;
    error_log /var/log/nginx/anass-erekysy.error.log;
    
    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;
    
    # Cache pour les assets statiques
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # SPA routing - toutes les routes pointent vers index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }
    
    # Sécurité
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Désactiver l'affichage de la version Nginx
    server_tokens off;
}

