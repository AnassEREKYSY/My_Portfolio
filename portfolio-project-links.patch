+        <dd class="modal-links">
+          <a [href]="selectedProject.liveUrl" target="_blank" rel="noopener noreferrer" class="text-link live-link">{{ host(selectedProject.liveUrl) }} ↗</a>
+        </dd>
+      </div>
+
       <div class="modal-row" *ngIf="selectedProject.githubRepos.length">
         <dt class="label">{{ 'projects.sourceCode' | translate }}</dt>
         <dd class="modal-links">
